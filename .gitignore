# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...kecuali template-nya, yang memang harus ikut ter-commit.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kredensial OAuth yang diunduh dari Google Cloud Console. Pola, bukan nama
# file tertentu — client bisa dibuat ulang kapan saja dan nama unduhannya
# ikut berubah, dan yang berikutnya harus tetap terabaikan tanpa perlu
# ingat mengedit baris ini.
client_secret_*.json

# --- Tidak ikut ke remote publik -------------------------------------
# Repo ini publik. Yang di bawah ini disimpan lokal saja karena memuat
# identitas internal (project ID Supabase, email tim & akun Drive, nama
# klien) atau konteks bisnis yang tidak perlu terbaca siapa pun.

# PRD & catatan perencanaan — memuat nama/peran tim, nama klien, keputusan
# bisnis, dan identitas project Supabase/Google Cloud.
docs/

# Migration & skrip diagnostik — sebagian menembak alamat email tim
# secara harfiah (mis. 005 mengatur super admin lewat email).
supabase/migrations/
supabase/diagnostics/
