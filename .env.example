# Salin file ini jadi .env.local lalu isi nilainya.
# Nilai yang sama juga perlu didaftarkan di Vercel:
# Project Settings > Environment Variables.

# --- Supabase ---------------------------------------------------------
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci publik. Aman terekspos di browser karena semua tabel dilindungi RLS.
# Di proyek Supabase baru namanya "publishable key", di proyek lama "anon key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Situs publik -------------------------------------------------------
# Dasar untuk canonical URL & hreflang di metadata (src/app/layout.tsx).
# Di server produksi HARUS diisi https://decaf.id lewat Portainer stack
# environment variables (jadi build arg Docker, bukan cuma runtime — lihat
# docker-compose.yml). Kalau kosong, metadata jatuh ke http://localhost:3000
# dan mesin telusur bisa menganggap localhost sebagai alamat kanonik.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Drive -----------------------------------------------------
# Kredensial akun Google khusus tim yang memiliki semua file Drive.
# JANGAN diberi prefiks NEXT_PUBLIC_ — ini rahasia, khusus sisi server.
# Langkah mendapatkannya ada di README bagian "Setup Google Drive".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID folder root di Drive tempat semua file sistem disimpan.
# Buat folder "Decaf Internal System" di Drive, lalu salin ID-nya dari URL:
# https://drive.google.com/drive/folders/<INI_ID_NYA>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Prototipe statis (opsional) --------------------------------------
# Folder tempat isi zip prototipe dibongkar. Boleh dikosongkan saat
# mengembangkan — nilai bawaannya ./.data/prototypes, yang sudah diabaikan
# git. Di server nilainya /app/data/prototypes, disetel oleh
# docker-compose.yml berikut volume-nya; JANGAN diarahkan ke folder biasa
# di dalam container, isinya akan hilang tiap redeploy.
# PROTOTYPES_DIR=

# --- Panel infrastruktur (opsional) -----------------------------------
# Mengisi kartu "Kesehatan Server" & "Pemantauan Layanan" di /backoffice/admin.
# Semuanya OPSIONAL: kalau dikosongkan, kartunya cuma bilang "belum
# dikonfigurasi" dan sisa halaman admin tetap jalan seperti biasa.
#
# Beszel memakai PocketBase, yang tidak punya API token — jadi bacanya lewat
# email+sandi yang ditukar jadi JWT tiap permintaan. Buat akun Beszel
# TERSENDIRI untuk ini, jangan pakai akun admin harianmu.
BESZEL_EMAIL=
BESZEL_PASSWORD=
# Uptime Kuma tidak punya REST API untuk dashboard-nya (isinya lewat
# socket.io), jadi yang dibaca endpoint Prometheus /metrics. Kuncinya dibuat
# di Uptime Kuma → Profile → API Keys.
UPTIME_KUMA_API_KEY=
# Alamat kedua layanan. Default menunjuk ke IP tailnet server. Isi ini HANYA
# kalau dari dalam container alamat itu ternyata tidak terjangkau — gantinya
# biasanya http://172.17.0.1:8090 (gateway bridge Docker).
# BESZEL_URL=
# UPTIME_KUMA_URL=

# Identitas perusahaan (nama, alamat, rekening bank, dst — dipakai dokumen
# dari template) BUKAN env var. Diisi & diubah lewat halaman
# Dokumen → Perusahaan di dalam aplikasi (tabel `company_settings`,
# migration 012) — supaya admin keuangan bisa mengubahnya sendiri tanpa
# minta developer redeploy.
