# Salin file ini jadi .env.local lalu isi nilainya.
# Nilai yang sama juga perlu didaftarkan di Vercel:
# Project Settings > Environment Variables.

# --- Supabase ---------------------------------------------------------
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci publik. Aman terekspos di browser karena semua tabel dilindungi RLS.
# Di proyek Supabase baru namanya "publishable key", di proyek lama "anon key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Drive -----------------------------------------------------
# Kredensial akun Google khusus tim yang memiliki semua file Drive.
# JANGAN diberi prefiks NEXT_PUBLIC_ — ini rahasia, khusus sisi server.
# Langkah mendapatkannya ada di README bagian "Setup Google Drive".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID folder root di Drive tempat semua file sistem disimpan.
# Buat folder "Decaf Internal System" di Drive, lalu salin ID-nya dari URL:
# https://drive.google.com/drive/folders/<INI_ID_NYA>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Identitas perusahaan (nama, alamat, rekening bank, dst — dipakai dokumen
# dari template) BUKAN env var. Diisi & diubah lewat halaman
# Dokumen → Perusahaan di dalam aplikasi (tabel `company_settings`,
# migration 012) — supaya admin keuangan bisa mengubahnya sendiri tanpa
# minta developer redeploy.
